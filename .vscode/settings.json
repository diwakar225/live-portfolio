{
  // Use the TypeScript installed in this project (6.x) rather than the one
  // bundled with the editor. The React Native base tsconfig uses compiler
  // options that older TypeScript versions cannot parse; when that happens the
  // editor silently drops the extended config and reports
  // "Cannot use JSX unless the '--jsx' flag is provided" on every .tsx file.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true
}
